{
  "compilerOptions": {
    "allowJs": true,
    "target": "ES2015",
    "lib": ["dom", "esnext"],
    "jsx": "react",
    "moduleResolution": "node",
    "module": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    ".storybook",
    "stories",
    "**/*.test.tsx",
    "**/*.test.ts"
  ]
}
